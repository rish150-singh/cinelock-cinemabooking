{
  "name": "cinelock",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w server",
    "test:load": "npm run test:load -w server",
    "db:migration:create": "npm run db:migration:create -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
